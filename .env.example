# Copy this file to .env.local for local development, and add the same
# variables in Vercel under Project > Settings > Environment Variables.

# The live address of the site, no trailing slash. Used for SEO tags,
# the sitemap, social share previews and auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Supabase dashboard > Project Settings > API Keys).
# Both values are safe to expose to the browser: access to data is enforced
# by Row Level Security (Phase 2). Never put the secret / service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_, never commit) ---

# Supabase secret key (Project Settings > API Keys > Secret keys). Used only on
# the server to store connection tokens in Vault and record connection status.
SUPABASE_SECRET_KEY=

# Random string of at least 32 characters. Encrypts the short-lived cookie that
# protects the Notion/Google connection round trip. e.g. `openssl rand -base64 48`
OAUTH_STATE_SECRET=

# Notion public integration (docs/SETUP_CONNECTIONS.md).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Google OAuth web client for the YouTube and Google Drive connections
# (docs/SETUP_CONNECTIONS.md). Can be the same client as Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where contact-form messages go (used once an email provider is connected).
CONTACT_TO_EMAIL=
